# Machine-owned ZCode state (workflow drafts, session state)
.zcode/

# Dependencies
node_modules/

# Next.js build output
.next/

# GitHub Pages static-site build output
site-dist/

# Environment / secrets (keep .env.example tracked)
.env*
!.env.example

# Local SQLite database and SQLite sidecar files
dev.db
dev.db-shm
dev.db-wal
dev.db-journal

# Drizzle-kit metadata artifacts
.drizzle/
drizzle/meta/

# TypeScript incremental build info
*.tsbuildinfo

# Playwright e2e artifacts
test-results/
playwright-report/

# Vitest coverage output
coverage/

# Agent-generated HTML reports (out/saasmath-plan.md stays tracked)
out/*.html

# Local agent/machine state
.video_agent/
.zcodeignore

# OS noise
.DS_Store
